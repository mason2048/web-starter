{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webstarter.dev/schema/release-evidence.schema.json",
  "title": "Web Starter immutable release evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "images", "sboms", "flyway", "inputs", "acceptance", "gate"],
  "properties": {
    "schemaVersion": {"const": 1},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "version", "gitCommit", "gitTagObject", "projectVersions"],
      "properties": {
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
        "gitCommit": {"$ref": "#/$defs/objectId"},
        "gitTagObject": {"$ref": "#/$defs/objectId"},
        "projectVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maven", "frontend"],
          "properties": {
            "maven": {"type": "string", "minLength": 1},
            "frontend": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "nginx"],
      "properties": {
        "app": {"$ref": "#/$defs/image"},
        "nginx": {"$ref": "#/$defs/image"}
      }
    },
    "sboms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "appImage", "nginxImage"],
      "properties": {
        "backend": {"$ref": "#/$defs/checksummedFile"},
        "frontend": {"$ref": "#/$defs/checksummedFile"},
        "appImage": {"$ref": "#/$defs/checksummedFile"},
        "nginxImage": {"$ref": "#/$defs/checksummedFile"}
      }
    },
    "flyway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "latestVersion", "migrations", "listSha256"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "latestVersion": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$"},
        "listSha256": {"$ref": "#/$defs/sha256"},
        "migrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "description", "path", "sha256"],
            "properties": {
              "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$"},
              "description": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceResults", "releaseImages", "securityGate", "productionCompose", "productionComposePolicy", "deploymentImages", "runtimeVersionIdentity", "releaseRuntimeAcceptance", "unifiedVerify", "ac40DependencySeedProvenance"],
      "properties": {
        "acceptanceResults": {"$ref": "#/$defs/checksummedFile"},
        "releaseImages": {"$ref": "#/$defs/checksummedFile"},
        "securityGate": {"$ref": "#/$defs/securityGateFile"},
        "productionCompose": {"$ref": "#/$defs/checksummedFile"},
        "productionComposePolicy": {"$ref": "#/$defs/securityGateFile"},
        "deploymentImages": {"$ref": "#/$defs/checksummedFile"},
        "runtimeVersionIdentity": {"$ref": "#/$defs/securityGateFile"},
        "releaseRuntimeAcceptance": {"$ref": "#/$defs/securityGateFile"},
        "unifiedVerify": {"$ref": "#/$defs/securityGateFile"},
        "v1SourceProvenanceSummary": {"$ref": "#/$defs/securityGateFile"},
        "v1ProjectIsolationSummary": {"$ref": "#/$defs/securityGateFile"},
        "releaseRuntimeTestReports": {"$ref": "#/$defs/securityGateFile"},
        "v1ProjectTransportParitySummary": {"$ref": "#/$defs/securityGateFile"},
        "jwksRotationSummary": {"$ref": "#/$defs/securityGateFile"},
        "mcpCrudRuntimeProofSummary": {"$ref": "#/$defs/securityGateFile"},
        "credentialLifecycleSummary": {"$ref": "#/$defs/securityGateFile"},
        "observabilitySummary": {"$ref": "#/$defs/securityGateFile"},
        "toolingLifecycleSummary": {"$ref": "#/$defs/securityGateFile"},
        "mcpToolContractSummary": {"$ref": "#/$defs/securityGateFile"},
        "mcpGovernanceRuntimeSummary": {"$ref": "#/$defs/securityGateFile"},
        "generatorAcceptanceSummary": {"$ref": "#/$defs/securityGateFile"},
        "productionFailFastRehearsal": {"$ref": "#/$defs/securityGateFile"},
        "v1UpgradeRehearsal": {"$ref": "#/$defs/securityGateFile"},
        "ac40DependencySeedProvenance": {"$ref": "#/$defs/securityGateFile"},
        "migrationFailureRehearsal": {"$ref": "#/$defs/securityGateFile"},
        "redisLossRehearsal": {"$ref": "#/$defs/securityGateFile"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1", "v2"],
      "properties": {
        "v1": {"$ref": "#/$defs/suite"},
        "v2": {"$ref": "#/$defs/suite"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluatedAt", "errors"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "evaluatedAt": {"type": "string", "format": "date-time"},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectId": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "checksummedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "securityGateFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "PASS"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "status", "observedAt", "evidence", "evidenceTrust"],
      "allOf": [
        {
          "if": {
            "required": ["id"],
            "properties": {"id": {"const": "V2-AC-45"}}
          },
          "then": {
            "properties": {"evidenceTrust": {"const": "GATE_DERIVED"}}
          },
          "else": {
            "if": {
              "required": ["status"],
              "properties": {"status": {"const": "PASS"}}
            },
            "then": {
              "properties": {"evidenceTrust": {"const": "GATE_INDEPENDENTLY_VERIFIED"}}
            },
            "else": {
              "properties": {"evidenceTrust": {"const": "CONTENT_HASH_VERIFIED"}}
            }
          }
        }
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:V2-)?AC-[0-9]{2}$"},
        "level": {"enum": ["P0", "P1"]},
        "status": {"enum": ["PASS", "FAIL", "NOT_COVERED", "ENV_REQUIRED"]},
        "observedAt": {"type": "string", "format": "date-time"},
        "evidenceTrust": {
          "enum": ["CONTENT_HASH_VERIFIED", "GATE_INDEPENDENTLY_VERIFIED", "GATE_DERIVED"],
          "description": "CONTENT_HASH_VERIFIED proves readable bytes and checksum only; GATE_INDEPENDENTLY_VERIFIED additionally proves a registered semantic verifier recomputed the acceptance outcome; GATE_DERIVED is reserved for V2-AC-45."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "results", "counts"],
      "properties": {
        "baseline": {"$ref": "#/$defs/checksummedFile"},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "levels", "statuses"],
          "properties": {
            "total": {"type": "integer", "minimum": 1},
            "levels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["P0", "P1"],
              "properties": {"P0": {"type": "integer", "minimum": 0}, "P1": {"type": "integer", "minimum": 0}}
            },
            "statuses": {
              "type": "object",
              "additionalProperties": false,
              "required": ["PASS", "FAIL", "NOT_COVERED", "ENV_REQUIRED"],
              "properties": {
                "PASS": {"type": "integer", "minimum": 0},
                "FAIL": {"type": "integer", "minimum": 0},
                "NOT_COVERED": {"type": "integer", "minimum": 0},
                "ENV_REQUIRED": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
