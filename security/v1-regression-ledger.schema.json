{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webstarter.dev/schema/v1-regression-ledger.schema.json",
  "title": "Web Starter V1 current-candidate regression ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "suite", "mode", "observedAt", "baseline", "candidate",
    "source", "evidenceSources", "checks", "results", "counts", "conclusion", "errors"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "suite": {"const": "v1"},
    "mode": {"enum": ["plan", "non-container", "full"]},
    "observedAt": {"type": "string", "format": "date-time"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "docs/acceptance/v1-acceptance-baseline.md"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifestSha256", "release", "images"],
      "properties": {
        "kind": {"enum": ["working-tree", "immutable-release"]},
        "manifestSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "release": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["tag", "version", "gitCommit"],
              "properties": {
                "tag": {"type": "string"},
                "version": {"type": "string"},
                "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"}
              }
            }
          ]
        },
        "images": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["app", "nginx", "mysql", "redis"],
              "properties": {
                "app": {"$ref": "#/$defs/imageReference"},
                "nginx": {"$ref": "#/$defs/imageReference"},
                "mysql": {"$ref": "#/$defs/imageReference"},
                "redis": {"$ref": "#/$defs/imageReference"}
              }
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "gitTree", "sourceArchiveSha256", "indexNormal", "trackedDiffSha256", "untrackedSourceSha256", "untrackedSourceCount", "clean"],
      "properties": {
        "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "gitTree": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "sourceArchiveSha256": {"$ref": "#/$defs/sha256"},
        "indexNormal": {"type": "boolean"},
        "trackedDiffSha256": {"$ref": "#/$defs/sha256"},
        "untrackedSourceSha256": {"$ref": "#/$defs/sha256"},
        "untrackedSourceCount": {"type": "integer", "minimum": 0},
        "clean": {"type": "boolean"}
      }
    },
    "evidenceSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["producer"],
        "properties": {
          "producer": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][A-Za-z0-9.]{2,127}$"},
      "additionalProperties": {"enum": ["PASS", "FAIL", "NOT_COVERED", "ENV_REQUIRED"]}
    },
    "results": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "status", "requirements"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{2}$"},
          "level": {"enum": ["P0", "P1"]},
          "status": {"enum": ["PASS", "FAIL", "NOT_COVERED", "ENV_REQUIRED"]},
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check", "status"],
              "properties": {
                "check": {"type": "string", "pattern": "^[a-z][A-Za-z0-9.]{2,127}$"},
                "status": {"enum": ["PASS", "FAIL", "NOT_COVERED", "ENV_REQUIRED"]}
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "levels", "statuses"],
      "properties": {
        "total": {"const": 42},
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P0", "P1"],
          "properties": {
            "P0": {"type": "integer", "minimum": 0},
            "P1": {"type": "integer", "minimum": 0}
          }
        },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PASS", "FAIL", "NOT_COVERED", "ENV_REQUIRED"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0},
            "NOT_COVERED": {"type": "integer", "minimum": 0},
            "ENV_REQUIRED": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "conclusion": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"}
  }
}
