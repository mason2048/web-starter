{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webstarter.dev/schema/v2-credential-lifecycle-runtime-summary.schema.json",
  "title": "Web Starter V2 credential lifecycle canonical summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptanceIds", "status", "candidate", "runtime", "checks", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "acceptanceIds": {
      "type": "array",
      "prefixItems": [
        {"const": "V2-AC-24"},
        {"const": "V2-AC-27"},
        {"const": "V2-AC-28"},
        {"const": "V2-AC-36"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "status": {"const": "PASS"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTag", "releaseVersion", "gitCommit", "gitTree", "tagObject",
        "appImageReference", "nginxImageReference"
      ],
      "properties": {
        "releaseTag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
        "releaseVersion": {"$ref": "#/$defs/version"},
        "gitCommit": {"$ref": "#/$defs/gitObject"},
        "gitTree": {"$ref": "#/$defs/gitObject"},
        "tagObject": {"$ref": "#/$defs/gitObject"},
        "appImageReference": {"$ref": "#/$defs/imageReference"},
        "nginxImageReference": {"$ref": "#/$defs/imageReference"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composeProject", "runtimeIdentitySha256", "oauthRuntimeReportSha256"],
      "properties": {
        "composeProject": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
        "runtimeIdentitySha256": {"$ref": "#/$defs/sha256"},
        "oauthRuntimeReportSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cascadeInvalidation", "authorizationCodeLifecycle", "pepperRotation", "clientSecretRotation",
        "clientCredentialsLifecycle", "serviceAccountLifecycle", "personalTokenLifecycle",
        "unifiedSecurityRegression", "plaintextCredentialAbsence", "fixtureCleanup"
      ],
      "properties": {
        "cascadeInvalidation": {"const": "PASS"},
        "authorizationCodeLifecycle": {"const": "PASS"},
        "fixtureCleanup": {"const": "PASS"},
        "pepperRotation": {"const": "PASS"},
        "clientSecretRotation": {"const": "PASS"},
        "clientCredentialsLifecycle": {"const": "PASS"},
        "serviceAccountLifecycle": {"const": "PASS"},
        "personalTokenLifecycle": {"const": "PASS"},
        "unifiedSecurityRegression": {"const": "PASS"},
        "plaintextCredentialAbsence": {"const": "PASS"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportSha256", "sourceSha256"],
      "properties": {
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "sourceSha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scripts/rehearse_credential_lifecycle.py",
            "scripts/validate_credential_lifecycle_evidence.py",
            "scripts/verify_oauth_runtime.py",
            "security/v2-credential-lifecycle-runtime-summary.schema.json",
            "deploy/nginx/external-mcp.conf",
            "web-starter-system/src/main/java/dev/webstarter/system/service/UserService.java",
            "web-starter-system/src/main/java/dev/webstarter/system/service/impl/UserServiceImpl.java",
            "web-starter-security/src/main/java/dev/webstarter/security/web/AccountSecurityController.java",
            "web-starter-security/src/main/java/dev/webstarter/security/session/IdentitySecurityLifecycleAdapter.java",
            "web-starter-security/src/main/java/dev/webstarter/security/token/CredentialPepperKeyRing.java",
            "web-starter-security/src/main/java/dev/webstarter/security/token/AccessCredentialService.java",
            "web-starter-security/src/main/java/dev/webstarter/security/oauth/OAuthClientManagementService.java",
            "web-starter-security/src/main/java/dev/webstarter/security/oauth/OAuthClientSecretPasswordEncoder.java",
            "web-starter-admin/src/main/resources/db/migration/V7__add_credential_rotation.sql",
            "web-starter-web/src/views/security/AccountSecurityView.vue"
          ],
          "properties": {
            "scripts/rehearse_credential_lifecycle.py": {"$ref": "#/$defs/sha256"},
            "scripts/validate_credential_lifecycle_evidence.py": {"$ref": "#/$defs/sha256"},
            "scripts/verify_oauth_runtime.py": {"$ref": "#/$defs/sha256"},
            "security/v2-credential-lifecycle-runtime-summary.schema.json": {"$ref": "#/$defs/sha256"},
            "deploy/nginx/external-mcp.conf": {"$ref": "#/$defs/sha256"},
            "web-starter-system/src/main/java/dev/webstarter/system/service/UserService.java": {"$ref": "#/$defs/sha256"},
            "web-starter-system/src/main/java/dev/webstarter/system/service/impl/UserServiceImpl.java": {"$ref": "#/$defs/sha256"},
            "web-starter-security/src/main/java/dev/webstarter/security/web/AccountSecurityController.java": {"$ref": "#/$defs/sha256"},
            "web-starter-security/src/main/java/dev/webstarter/security/session/IdentitySecurityLifecycleAdapter.java": {"$ref": "#/$defs/sha256"},
            "web-starter-security/src/main/java/dev/webstarter/security/token/CredentialPepperKeyRing.java": {"$ref": "#/$defs/sha256"},
            "web-starter-security/src/main/java/dev/webstarter/security/token/AccessCredentialService.java": {"$ref": "#/$defs/sha256"},
            "web-starter-security/src/main/java/dev/webstarter/security/oauth/OAuthClientManagementService.java": {"$ref": "#/$defs/sha256"},
            "web-starter-security/src/main/java/dev/webstarter/security/oauth/OAuthClientSecretPasswordEncoder.java": {"$ref": "#/$defs/sha256"},
            "web-starter-admin/src/main/resources/db/migration/V7__add_credential_rotation.sql": {"$ref": "#/$defs/sha256"},
            "web-starter-web/src/views/security/AccountSecurityView.vue": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
    "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"}
  }
}
