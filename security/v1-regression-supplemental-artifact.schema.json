{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webstarter.dev/schema/v1-regression-supplemental-artifact.schema.json",
  "title": "Web Starter V1 status-free supplemental evidence artifact",
  "description": "Common structural envelope for one supplemental atomic check. It intentionally has no status field; a registered validator must derive the result from observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "producer", "check", "candidate", "observations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "suite": {"const": "v1"},
    "producer": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
    "check": {"type": "string", "pattern": "^supplemental\\.[a-z][A-Za-z0-9.]{2,114}$"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "observations": {
      "type": "object",
      "minProperties": 1
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "gitCommit", "gitTree", "sourceArchiveSha256", "releaseTag", "releaseVersion"],
      "properties": {
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "gitCommit": {"$ref": "#/$defs/gitObject"},
        "gitTree": {"$ref": "#/$defs/gitObject"},
        "sourceArchiveSha256": {"$ref": "#/$defs/sha256"},
        "releaseTag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
        "releaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"}
      }
    }
  }
}
