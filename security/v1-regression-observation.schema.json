{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webstarter.dev/schema/v1-regression-observation.schema.json",
  "title": "Web Starter V1 candidate-bound supplemental observation",
  "description": "A fail-closed, credential-free index over sanitized, status-free evidence artifacts. Only source-registered semantic validators may derive a check status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "candidate", "producer", "observedAt", "artifacts", "checks"],
  "properties": {
    "schemaVersion": {"const": 2},
    "suite": {"const": "v1"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "producer": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
          "path": {"type": "string", "pattern": "^artifacts/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifactIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^supplemental\\.[a-z][A-Za-z0-9.]{2,114}$"},
          "artifactIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "gitCommit", "gitTree", "sourceArchiveSha256", "releaseTag", "releaseVersion"],
      "properties": {
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "gitCommit": {"$ref": "#/$defs/gitObject"},
        "gitTree": {"$ref": "#/$defs/gitObject"},
        "sourceArchiveSha256": {"$ref": "#/$defs/sha256"},
        "releaseTag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
        "releaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"}
      }
    }
  }
}
