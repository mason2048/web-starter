# Copy this file to .env for local Docker Compose use.
# Values below are placeholders for local development only. Never reuse them in production.

# Local image names. Production should use an immutable release tag from a registry
# and start with --no-build.
WEB_STARTER_APP_IMAGE=web-starter-app
WEB_STARTER_NGINX_IMAGE=web-starter-nginx
WEB_STARTER_IMAGE_TAG=local

WEB_STARTER_DB_ROOT_PASSWORD=replace-with-a-local-root-password
WEB_STARTER_DB_USERNAME=web_starter
WEB_STARTER_DB_PASSWORD=replace-with-a-local-database-password
WEB_STARTER_DB_PORT=33060

WEB_STARTER_REDIS_PASSWORD=replace-with-a-local-redis-password
WEB_STARTER_REDIS_PORT=63790
WEB_STARTER_REDIS_DATABASE=0

# Use at least 32 random bytes in every non-test environment.
WEB_STARTER_TOKEN_PEPPER=replace-with-at-least-32-random-bytes

# Required only on an empty database. Remove the password after the first successful startup.
WEB_STARTER_BOOTSTRAP_ADMIN_USERNAME=admin
WEB_STARTER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
WEB_STARTER_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

WEB_STARTER_OAUTH_ISSUER=http://localhost:8088
WEB_STARTER_OAUTH_RESOURCE_AUDIENCE=http://localhost:8088/mcp
WEB_STARTER_OAUTH_ACCESS_TOKEN_TTL=10m
WEB_STARTER_OAUTH_REFRESH_TOKEN_TTL=8h
# Local-only convenience. Production must set this to false and inject persistent RSA keys.
WEB_STARTER_OAUTH_DEVELOPMENT_KEYS_ALLOWED=true
WEB_STARTER_OAUTH_RSA_PRIVATE_KEY=
WEB_STARTER_OAUTH_RSA_PUBLIC_KEY=
WEB_STARTER_INTERNAL_TOKENS_ENABLED=true
# Host is always required. Production must explicitly add every real internal/public MCP hostname.
WEB_STARTER_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# Browser MCP requests with Origin must match this list. Server-side Agents normally omit Origin.
WEB_STARTER_MCP_ALLOWED_ORIGINS=http://localhost,http://localhost:*,https://localhost,https://localhost:*,http://127.0.0.1,http://127.0.0.1:*,https://127.0.0.1,https://127.0.0.1:*,http://[::1],http://[::1]:*,https://[::1],https://[::1]:*
WEB_STARTER_COOKIE_SECURE=false
WEB_STARTER_SERVER_PORT=8080
WEB_STARTER_HTTP_BIND_ADDRESS=0.0.0.0
WEB_STARTER_HTTP_PORT=8088
WEB_STARTER_LOG_LEVEL=INFO

# Used only with compose.public-mcp.yaml. Keep certificate material outside the repository.
WEB_STARTER_PUBLIC_MCP_BIND_ADDRESS=0.0.0.0
WEB_STARTER_PUBLIC_MCP_PORT=8443
WEB_STARTER_PUBLIC_TLS_CERT_FILE=
WEB_STARTER_PUBLIC_TLS_KEY_FILE=
