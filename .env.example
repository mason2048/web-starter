# Copy this file to .env for local Docker Compose use.
# Values below are placeholders for local development only. Never reuse them in production.

# Local image names. Production should use an immutable release tag from a registry
# and start with --no-build.
WEB_STARTER_APP_IMAGE=web-starter-app
WEB_STARTER_NGINX_IMAGE=web-starter-nginx
WEB_STARTER_IMAGE_TAG=local

# compose.production.yaml does not use IMAGE_TAG and never builds locally. Copy
# the four values below from the successful release supply-chain artifact.
WEB_STARTER_APP_DIGEST=
WEB_STARTER_NGINX_DIGEST=
# Production dependency images must also be complete repository@sha256 refs.
WEB_STARTER_MYSQL_IMAGE=
WEB_STARTER_REDIS_IMAGE=

# Production container budgets; tune from measured load, never remove them.
WEB_STARTER_APP_CPU_LIMIT=2.0
WEB_STARTER_APP_CPU_RESERVATION=0.25
WEB_STARTER_APP_MEMORY_LIMIT=1024M
WEB_STARTER_APP_MEMORY_RESERVATION=256M
WEB_STARTER_APP_PIDS_LIMIT=256
WEB_STARTER_NGINX_CPU_LIMIT=1.0
WEB_STARTER_NGINX_CPU_RESERVATION=0.10
WEB_STARTER_NGINX_MEMORY_LIMIT=256M
WEB_STARTER_NGINX_MEMORY_RESERVATION=64M
WEB_STARTER_NGINX_PIDS_LIMIT=128

# development | test | production. Production enables mandatory startup safety checks.
WEB_STARTER_RUNTIME_MODE=development
# MCP initialize and system.info expose this non-secret source identity. Keep
# `local` only for development; production must inject the exact release commit.
WEB_STARTER_GIT_COMMIT=local

WEB_STARTER_DB_ROOT_PASSWORD=replace-with-a-local-root-password
WEB_STARTER_DB_USERNAME=web_starter
WEB_STARTER_DB_PASSWORD=replace-with-a-local-database-password
WEB_STARTER_DB_PORT=33060
WEB_STARTER_DB_POOL_MAX_SIZE=20
WEB_STARTER_DB_POOL_MIN_IDLE=2
# Keep readiness bounded when MySQL is unreachable; validation must be shorter than acquisition.
WEB_STARTER_DB_CONNECTION_TIMEOUT_MS=5000
WEB_STARTER_DB_VALIDATION_TIMEOUT_MS=2000

WEB_STARTER_REDIS_PASSWORD=replace-with-a-local-redis-password
WEB_STARTER_REDIS_PORT=63790
WEB_STARTER_REDIS_DATABASE=0

# Browser Session TTL. Redis remains rebuildable; this does not control MCP Session TTL.
WEB_STARTER_SESSION_TIMEOUT=8h

# Use at least 32 random bytes in every non-test environment.
WEB_STARTER_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
# Long-lived PAT/service-token Pepper. Empty preserves V1 by falling back to TOKEN_PEPPER.
WEB_STARTER_CREDENTIAL_PEPPER=
WEB_STARTER_CREDENTIAL_PEPPER_ACTIVE_VERSION=v1
# During rotation both retiring fields must be set together, then removed together.
WEB_STARTER_CREDENTIAL_PEPPER_RETIRING=
WEB_STARTER_CREDENTIAL_PEPPER_RETIRING_VERSION=

# Required only on an empty database. Remove the password after the first successful startup.
WEB_STARTER_BOOTSTRAP_ADMIN_USERNAME=admin
WEB_STARTER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
WEB_STARTER_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

WEB_STARTER_OAUTH_ISSUER=http://localhost:8088
WEB_STARTER_OAUTH_RESOURCE_AUDIENCE=http://localhost:8088/mcp
WEB_STARTER_OAUTH_ACCESS_TOKEN_TTL=10m
WEB_STARTER_OAUTH_REFRESH_TOKEN_TTL=8h
# Old and new confidential-client secrets overlap for 15 minutes by default;
# no API caller may request a window longer than this maximum.
WEB_STARTER_OAUTH_CLIENT_SECRET_OVERLAP=15m
WEB_STARTER_OAUTH_CLIENT_SECRET_MAX_OVERLAP=24h
WEB_STARTER_LOGIN_RATE_LIMIT_ENABLED=true
WEB_STARTER_LOGIN_RATE_LIMIT_MAX_FAILURES_PER_IDENTITY=5
# Pair means normalized account plus trusted client source address. No IP-only key blocks other accounts.
WEB_STARTER_LOGIN_RATE_LIMIT_MAX_FAILURES_PER_PAIR=5
WEB_STARTER_LOGIN_RATE_LIMIT_WINDOW=15m
WEB_STARTER_LOGIN_RATE_LIMIT_INITIAL_BACKOFF=2s
WEB_STARTER_LOGIN_RATE_LIMIT_MAX_BACKOFF=15m
# Local-only convenience. Production must set this to false and inject persistent RSA keys.
WEB_STARTER_OAUTH_DEVELOPMENT_KEYS_ALLOWED=true
# Preferred rotation format: a one-line RSA JWK Set with stable, unique kid
# values. Exactly one key named below is active and must contain private
# material; retiring verification keys may be public-only.
WEB_STARTER_OAUTH_RSA_JWK_SET=
WEB_STARTER_OAUTH_RSA_ACTIVE_KEY_ID=
# Legacy single-key fallback. Leave these empty when using the JWK Set above.
WEB_STARTER_OAUTH_RSA_PRIVATE_KEY=
WEB_STARTER_OAUTH_RSA_PUBLIC_KEY=
WEB_STARTER_INTERNAL_TOKENS_ENABLED=true
# Host is always required. Production must explicitly add every real internal/public MCP hostname.
WEB_STARTER_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# Browser MCP requests with Origin must match this list. Server-side Agents normally omit Origin.
WEB_STARTER_MCP_ALLOWED_ORIGINS=http://localhost,http://localhost:*,https://localhost,https://localhost:*,http://127.0.0.1,http://127.0.0.1:*,https://127.0.0.1,https://127.0.0.1:*,http://[::1],http://[::1]:*,https://[::1],https://[::1]:*
# V2 write-tool retry records. Only hashes and the stable response are retained.
WEB_STARTER_MCP_IDEMPOTENCY_TTL=24h
WEB_STARTER_MCP_IDEMPOTENCY_CLEANUP_INTERVAL=10m
# Redis stores only rebuildable MCP lifecycle and limit coordination data.
WEB_STARTER_MCP_SESSION_ENABLED=true
WEB_STARTER_MCP_SESSION_IDLE_TTL=30m
WEB_STARTER_MCP_SESSION_ABSOLUTE_TTL=8h
WEB_STARTER_MCP_SESSION_MAX_PER_SUBJECT=8
WEB_STARTER_MCP_SESSION_RESERVATION_TTL=30s
WEB_STARTER_MCP_RATE_LIMIT_ENABLED=true
WEB_STARTER_MCP_RATE_LIMIT_WINDOW=1m
WEB_STARTER_MCP_RATE_LIMIT_MAX_PER_SUBJECT=240
WEB_STARTER_MCP_RATE_LIMIT_MAX_PER_CLIENT=480
WEB_STARTER_MCP_RATE_LIMIT_MAX_READ=180
WEB_STARTER_MCP_RATE_LIMIT_MAX_WRITE=60
WEB_STARTER_MCP_RATE_LIMIT_MAX_DESTRUCTIVE=20
WEB_STARTER_MCP_RATE_LIMIT_MAX_PROTOCOL=120
WEB_STARTER_COOKIE_SECURE=false
WEB_STARTER_SERVER_PORT=8080
# The management port is container-internal in Compose and is never published by default.
WEB_STARTER_MANAGEMENT_PORT=8081
WEB_STARTER_MANAGEMENT_BIND_ADDRESS=127.0.0.1
# Dedicated Spring Security credentials for info, metrics, and prometheus.
# They are unrelated to Web users, OAuth clients, PATs, and service accounts.
# Production requires a unique username and at least 32 random password characters.
WEB_STARTER_MANAGEMENT_USERNAME=
WEB_STARTER_MANAGEMENT_PASSWORD=
# Private management ingress defaults to loopback. Production may use only an
# explicitly controlled RFC1918 address or IPv6 ULA; never 0.0.0.0 or ::.
WEB_STARTER_HTTP_BIND_ADDRESS=127.0.0.1
WEB_STARTER_HTTP_PORT=8088
WEB_STARTER_LOG_FORMAT=ecs
WEB_STARTER_LOG_LEVEL=INFO

# Used only with compose.public-mcp.yaml. Keep certificate material outside the repository.
WEB_STARTER_PUBLIC_MCP_BIND_ADDRESS=0.0.0.0
WEB_STARTER_PUBLIC_MCP_PORT=8443
WEB_STARTER_PUBLIC_TLS_CERT_FILE=
WEB_STARTER_PUBLIC_TLS_KEY_FILE=
