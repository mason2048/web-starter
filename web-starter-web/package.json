{
  "name": "web-starter-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run contract:check && pnpm run typecheck && vite build && pnpm run bundle:check && pnpm run production:mount-check",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "contract:check": "node scripts/check-private-api-contract.mjs",
    "contract:write": "node scripts/render-private-api-contract.mjs",
    "production:mount-check": "node scripts/check-production-mount.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test e2e/release-runtime.spec.ts e2e/frontend-quality-runtime.spec.ts e2e/v1-management-runtime.spec.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.12.2",
    "element-plus": "2.14.3",
    "pinia": "^3.0.4",
    "vue": "3.5.40",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "1.61.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.1",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue-tsc": "^3.1.1"
  }
}
